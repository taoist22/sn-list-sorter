{
  "name": "ListSorter",
  "version": "1.1.0-beta",
  "description": "Lasso a handwritten or typed list, sort it alphabetically, and insert it with your choice of format and alignment.",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "patch:metro-watchers": "node tools/patch-metro-watchers.js",
    "build": "npm run patch:metro-watchers && bash buildPlugin.sh",
    "test:coverage": "jest --coverage --runInBand --watchman=false",
    "validate:package": "node tools/validate-plugin-package.js",
    "verify:release": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run validate:package"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.79.2",
    "sn-plugin-lib": "0.1.65"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
